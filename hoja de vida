body {
    font-family: Arial, sans-serif;
    background-color: #eeeeee;
    margin: 0;
    padding: 20px;
}

.contenedor {
    width: 90%;
    max-width: 900px;
    margin: auto;
    background-color: white;
    padding: 25px;
    border-radius: 15px;
}

/* ENCABEZADO */

header {
    text-align: center;
    background-color: #222222;
    color: white;
    padding: 30px;
    border-radius: 15px;
}

header h2 {
    color: white;
}

.foto {
    width: 130px;
    height: 130px;
    border-radius: 50%;
    object-fit: cover;
}


/* SECCIONES */

section {
    margin-top: 25px;
    padding: 20px;
    border-radius: 10px;
    background-color: #f8f8f8;
}

section h2 {
    color: #222222;
}


/* TARJETAS */

.tarjeta {
    background-color: white;
    padding: 15px;
    border-radius: 10px;
    box-shadow: 0 2px 5px #cccccc;
}


/* BARRAS */

.barra {
    width: 100%;
    height: 25px;
    background-color: #dddddd;
    border-radius: 15px;
    margin-bottom: 15px;
}

.progreso {
    height: 25px;
    color: white;
    text-align: center;
    border-radius: 15px;
    line-height: 25px;
}

.uno {
    width: 90%;
    background-color: #333333;
}

.dos {
    width: 85%;
    background-color: #444444;
}

.tres {
    width: 90%;
    background-color: #555555;
}

.cuatro {
    width: 85%;
    background-color: #666666;
}


/* BOTONES */

.botones {
    text-align: center;
    margin-top: 20px;
}

.botones a {
    display: inline-block;
    background-color: #222222;
    color: white;
    text-decoration: none;
    padding: 10px 20px;
    margin: 5px;
    border-radius: 5px;
}

.botones a:hover {
    background-color: #555555;
}


/* BOTÓN JAVASCRIPT */

button {
    display: block;
    margin: 30px auto 10px;
    padding: 12px 25px;
    border: none;
    border-radius: 8px;
    background-color: #222222;
    color: white;
    cursor: pointer;
    font-size: 16px;
}

button:hover {
    background-color: #555555;
}

#mensaje {
    text-align: center;
    font-weight: bold;
}


/* PIE DE PÁGINA */

footer {
    text-align: center;
    margin-top: 30px;
    padding: 15px;
    color: #666666;
}
